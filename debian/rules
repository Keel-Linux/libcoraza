#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk

SOMAJOR = 1
LIBDIR = usr/lib/$(DEB_HOST_MULTIARCH)
GO_ROOT = /usr/lib/go-1.26

# Offline, from vendor/ only (debian/README.source), with the Go of
# golang-1.26-go and never a downloaded toolchain.
export PATH := $(GO_ROOT)/bin:$(PATH)
export GOPATH = $(CURDIR)/debian/.gopath
export GOCACHE = $(CURDIR)/debian/.gocache
export GOPROXY = off
export GOTOOLCHAIN = local
export GOFLAGS = -mod=vendor -trimpath -buildvcs=false \
	-ldflags=-extldflags=-Wl,-soname,libcoraza.so.$(SOMAJOR)
export CGO_ENABLED = 1
export CGO_CFLAGS = $(CFLAGS) $(CPPFLAGS)
export CGO_LDFLAGS = $(LDFLAGS)

%:
	dh $@

override_dh_autoreconf:
	dh_autoreconf ./build.sh

override_dh_auto_configure:
	dh_auto_configure -- --libdir=/$(LIBDIR)

override_dh_auto_build:
	$(MAKE) coraza/coraza.h libcoraza.so

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# The upstream C test links the static archive; go test -race is
	# skipped as upstream's own package does (not on every architecture).
	$(MAKE) libcoraza.a tests/simple_get
	cd tests && ./check_result.sh simple_get
	go test ./...
endif

override_dh_auto_install:
	install -d debian/tmp/$(LIBDIR) debian/tmp/usr/include/coraza
	install -m 0644 libcoraza.so debian/tmp/$(LIBDIR)/libcoraza.so.$(DEB_VERSION_UPSTREAM)
	ln -s libcoraza.so.$(DEB_VERSION_UPSTREAM) debian/tmp/$(LIBDIR)/libcoraza.so.$(SOMAJOR)
	ln -s libcoraza.so.$(SOMAJOR) debian/tmp/$(LIBDIR)/libcoraza.so
	install -m 0644 coraza/coraza.h debian/tmp/usr/include/coraza/coraza.h

override_dh_dwz:
	# dwz does not handle the DWARF of a cgo shared object

override_dh_gencontrol:
	dh_gencontrol -- -Vmisc:Static-Built-Using="$(shell dpkg-query -f='$${source:Package} (= $${source:Version})' -W golang-1.26-go)"

override_dh_auto_clean:
	[ ! -f Makefile ] || $(MAKE) distclean
	chmod -Rf u+w debian/.gopath debian/.gocache 2>/dev/null || true
	rm -rf debian/.gopath debian/.gocache coraza libcoraza.so libcoraza.a libcoraza.h
